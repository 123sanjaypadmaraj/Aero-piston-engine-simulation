# =============================================================================
# Aero Piston Engine Digital Twin - environment reference
#
#   cp .env.example .env        (.env is gitignored - never commit real keys)
#
# Every variable is OPTIONAL. Values shown are the defaults; commented-out lines
# are simply not set. The app boots and works with an empty .env: without any AI
# key it runs in a degraded mode where the dashboard shows rule-based summaries
# instead of LLM narratives (all telemetry, health scores and alerts still work).
# Invalid values fail fast at startup with a message listing every problem.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# development | production. Production defaults CORS to same-origin only and
# reduces error detail in API responses. The Docker image sets this for you.
NODE_ENV=development

# HTTP port and bind address. Use HOST=127.0.0.1 to listen on loopback only
# (e.g. behind a reverse proxy on the same machine).
PORT=5000
HOST=0.0.0.0

# Comma-separated allowlist of browser origins allowed to call the API / connect
# Socket.IO from another origin, e.g. https://twin.example.com,https://ops.example.com
# Unset = permissive in development, same-origin only in production.
# "*" = allow any origin (explicit opt-in; not recommended in production).
# CORS_ORIGIN=

# Set when running behind a reverse proxy / load balancer so client IPs (rate
# limiting) and protocol are taken from X-Forwarded-* headers. Values: true,
# false, a hop count (1 = one proxy), or an Express subnet list
# ("loopback, 10.0.0.0/8"). Leave unset when the app is directly exposed -
# otherwise clients can spoof their IP and bypass rate limits.
# TRUST_PROXY=1

# Log verbosity: silent | error | warn | info | debug
LOG_LEVEL=info

# Milliseconds allowed for in-flight requests / sockets to drain on SIGTERM/SIGINT
# before the process force-exits. Keep your orchestrator's stop grace period
# (docker stop_grace_period, k8s terminationGracePeriodSeconds) above this.
SHUTDOWN_TIMEOUT_MS=10000

# Live telemetry tick interval in ms (each tick advances the simulation and
# broadcasts a Socket.IO `snapshot`).
# TICK_MS=2000


# -----------------------------------------------------------------------------
# Security / abuse protection
# -----------------------------------------------------------------------------

# Optional shared secret guarding the mutating POST routes (mission runs, replay,
# forced AI refresh). When set, callers must send it in the `x-api-key` header.
# Read-only GET routes and the dashboard stay open. Minimum 8 characters; use a
# long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Unset = mutating routes are open (fine for local demos, not for a public host).
# ADMIN_API_KEY=

# Per-IP rate limit for /api/*: window length and max requests per window.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Tighter per-window cap for expensive routes (mission runs, replay, AI refresh).
RATE_LIMIT_HEAVY_MAX=10

# Socket.IO connection caps (per client IP, and total across all clients).
# SOCKET_MAX_PER_IP=20
# SOCKET_MAX_TOTAL=500

# Maximum physics missions (POST /api/engine-sim/run) executing at once.
# MAX_CONCURRENT_MISSIONS=2


# -----------------------------------------------------------------------------
# AI "Engine Situation" narratives (RAG + LLM)
#
# Two providers are supported: Gemini (primary) and Groq (fallback). Both keys are
# optional, but set at least one to get LLM narratives; set both for resilience.
# Without a key the dashboard falls back to a rule-based one-line summary.
# -----------------------------------------------------------------------------

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Model used for analysis. gemini-*-flash-lite models are the cheapest and have
# the highest free-tier quota (roughly 15 RPM / 1000 RPD) - a good choice if you
# are hitting 429s. Check current limits: https://ai.google.dev/gemini-api/docs/rate-limits
# GEMINI_MODEL=gemini-2.5-flash
# Minimum ms between ANY two Gemini calls across the whole fleet (smooths bursts
# when several engines are due on the same tick).
# GEMINI_MIN_GAP_MS=13000

# Groq (free key: https://console.groq.com/keys) - used automatically when the
# preferred provider fails (missing key, 429 rate limit, timeout, empty/blocked
# response) or is in cooldown.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MIN_GAP_MS=2000

# Provider preference order, comma-separated. First available provider is tried
# first; the next one is the fallback.
# AI_PROVIDER_ORDER=gemini,groq

# Circuit breaker: after a provider fails, it is skipped for this many ms
# (default 5 minutes) so a quota-exhausted key is not hammered on every tick.
# AI_PROVIDER_COOLDOWN_MS=300000

# Minimum ms between automatic re-analyses of an engine whose condition has not
# changed (default 5 minutes). An analysis is ALSO triggered immediately whenever
# an engine's condition changes (nominal -> warning -> critical, or a fault
# starts/resolves). Keep this fairly long - some free-tier Gemini keys/models cap
# requests per DAY (as low as ~20/day), not just per minute.
# AI_ANALYSIS_INTERVAL_MS=300000

# Advanced AI tuning (rarely needed):
# AI_PROVIDER_AUTH_COOLDOWN_MS=3600000    cooldown after an auth / invalid-key / unknown-model error
# AI_PROVIDER_FAILURE_COOLDOWN_MS=60000   cooldown after 3 consecutive timeouts/5xx/network errors
# AI_DEGRADED_RETRY_MS=60000              retry delay for an engine showing the rule-based fallback
# AI_REQUEST_TIMEOUT_MS=20000             per-request timeout
# AI_MAX_PROMPT_CHARS=12000
# AI_MAX_RESPONSE_CHARS=2000
# AI_MAX_QUEUE=16                         max pending requests per provider


# -----------------------------------------------------------------------------
# Persistence (twin_core)
# -----------------------------------------------------------------------------

# Directory for recorded missions (JSON-Lines).
# Default: ./twin_core/data. In Docker this is /data (mount a volume there).
# TWIN_DATA_DIR=./twin_core/data

# Retention: keep at most this many recorded missions per engine; the oldest are
# pruned when the limit is exceeded.
# TWIN_MAX_MISSIONS_PER_ENGINE=50

# Safety cap on readings stored per recording (further appends are dropped).
# TWIN_MAX_READINGS_PER_MISSION=50000
