# Copy this file to .env and fill in your key (.env is already gitignored).

# Google Gemini API key used for the "AI Engine Situation" narrative feature.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for analysis (default: gemini-3.6-flash).
# gemini-3.5-flash-lite is the simplest/cheapest current model, with the
# highest free-tier quota (15 RPM / 1000 RPD) — good if you're hitting 429s.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: minimum milliseconds between automatic AI analyses per engine,
# for an engine whose condition hasn't changed (default: 5 minutes). An
# analysis is ALSO triggered immediately whenever an engine's condition
# changes (nominal -> warning -> critical, or a fault starts/resolves),
# regardless of this interval. Keep this fairly long — some free-tier
# Gemini keys/models cap requests per DAY (as low as ~20/day), not just
# per minute; see https://ai.google.dev/gemini-api/docs/rate-limits.
# AI_ANALYSIS_INTERVAL_MS=300000

# Optional: minimum milliseconds between ANY two Gemini calls across the
# whole fleet (not just per engine), to smooth out bursts when several
# engines are due for analysis on the same tick.
# GEMINI_MIN_GAP_MS=13000

# Optional: HTTP port for the server (default 5000).
# PORT=5000
