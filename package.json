{
  "name": "aero-engine-digital-twin",
  "version": "1.1.0",
  "private": true,
  "description": "AI-Enabled Real-Time Digital Twin System for Health Monitoring, Fault Prediction and Mission Reliability Enhancement of Aero Piston Engines used in MALE UAVs (SIH Prototype)",
  "main": "server.js",
  "license": "UNLICENSED",
  "keywords": [
    "digital-twin",
    "uav",
    "aero-engine",
    "predictive-maintenance",
    "socket.io",
    "express"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node start.js",
    "server": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "test:server": "node scripts/run-tests.js tests/server",
    "test:ai": "node scripts/run-tests.js tests/ai",
    "test:core": "node scripts/run-tests.js tests/core",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "socket.io": "^4.7.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
